# Build parameters for Iceberg OS, read by the Justfile and the GitHub workflows.

# Output image name (published as ghcr.io/<REPO_ORGANIZATION>/<IMAGE_NAME>)
IMAGE_NAME=iceberg-os

# Your GitHub username/organisation. CI overrides this automatically.
REPO_ORGANIZATION="kusule1351-hue"

IMAGE_DESC="Iceberg OS: an atomic KDE Plasma desktop built on Fedora Kinoite"
IMAGE_KEYWORDS="bootc,ostree,fedora,kinoite,kde,plasma,atomic"

IMAGE_LOGO_URL=""
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
